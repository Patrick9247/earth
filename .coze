[project]
requires = ["nodejs-24", "python-3.12"]

[dev]
build = [
    "bash", "-c", 
    "cd frontend && pnpm install && pnpm run build && cp -r dist/* ../backend/static/ && cd ../backend && pip install -r requirements.txt"
]
run = ["bash", "-c", "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 5000"]

[deploy]
build = [
    "bash", "-c",
    "cd frontend && pnpm install && pnpm run build && cp -r dist/* ../backend/static/ && cd ../backend && pip install -r requirements.txt"
]
run = ["bash", "-c", "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 5000"]
